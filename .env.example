# TELEGRAM_BOT_TOKEN: Bot token for Telegram webhook notifications (@SandBoxAutoBot).
# Configure the real token in the Secrets panel in AI Studio.
TELEGRAM_BOT_TOKEN=MY_TELEGRAM_BOT_TOKEN

# STRIPE_SANDBOX_SECRET_KEY: Stripe Test Mode secret key (must start with sk_test_).
# Configure in the Secrets panel in AI Studio for Stripe $0.00 SetupIntent sandbox checks.
STRIPE_SANDBOX_SECRET_KEY=sk_test_PLACEHOLDER_KEY

# STRIPE_SANDBOX_PUBLISHABLE_KEY: Stripe Test Mode publishable key (must start with pk_test_).
STRIPE_SANDBOX_PUBLISHABLE_KEY=pk_test_PLACEHOLDER_KEY

# BRAINTREE_SANDBOX_ACCESS_TOKEN: Braintree / PayPal Sandbox access token (access_token$sandbox$...).
BRAINTREE_SANDBOX_ACCESS_TOKEN=access_token_sandbox_PLACEHOLDER_TOKEN

# ADYEN_SANDBOX_API_KEY: Adyen Test Platform X-API-Key for $0.00 Zero-Value Auth.
ADYEN_SANDBOX_API_KEY=AQE_SANDBOX_PLACEHOLDER_KEY

# ADYEN_SANDBOX_MERCHANT_ACCOUNT: Adyen Test merchantAccount identifier.
ADYEN_SANDBOX_MERCHANT_ACCOUNT=YOUR_ADYEN_TEST_MERCHANT

# SQUARE_SANDBOX_ACCESS_TOKEN: Square Sandbox Bearer access token (connect.squareupsandbox.com).
SQUARE_SANDBOX_ACCESS_TOKEN=EAAA_SANDBOX_PLACEHOLDER_TOKEN

# AUTHNET_SANDBOX_API_LOGIN_ID: Authorize.Net Sandbox API Login ID (apitest.authorize.net).
AUTHNET_SANDBOX_API_LOGIN_ID=YOUR_AUTHNET_SANDBOX_LOGIN_ID

# AUTHNET_SANDBOX_TRANSACTION_KEY: Authorize.Net Sandbox Transaction Key.
AUTHNET_SANDBOX_TRANSACTION_KEY=YOUR_AUTHNET_SANDBOX_TXN_KEY

# CHECKOUT_SANDBOX_SECRET_KEY: Checkout.com Sandbox secret key (sk_sbox_...).
CHECKOUT_SANDBOX_SECRET_KEY=sk_sbox_PLACEHOLDER_KEY
